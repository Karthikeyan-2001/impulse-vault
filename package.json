{
  "name": "impulse-vault",
  "version": "1.0.0",
  "private": true,
  "description": "A mandatory 72-hour cooling-off period between wanting something online and buying it.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.2.9",
    "@types/node": "24.13.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "fflate": "0.8.3",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
