{
  "$schema": "./schema.json",
  "id": "flipkart.com",
  "name": "Flipkart",
  "domains": ["flipkart.com"],
  "currency": "INR",
  "productIdPattern": "/p/(itm[a-z0-9]+)(?:[/?#]|$)",
  "gatePathPattern": "p/{id}",
  "keepParams": ["pid"],
  "selectors": {
    "title": ["h1 span", "h1"],
    "price": [],
    "image": ["meta[property='og:image']"],
    "addToCart": [],
    "buyNow": [],
    "checkout": []
  },
  "cartPaths": ["viewcart", "checkout", "checkout/init", "rv/checkout"],
  "outOfStockText": ["sold out", "currently unavailable", "coming soon"]
}
